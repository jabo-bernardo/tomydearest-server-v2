generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionType {
  RANT
  DEDICATION_MESSAGE
}

enum ReactionType {
  LOVE
  HAHA
  SAD
  ANGRY
}

enum ReportReason {
  SPAM
  OFFENSIVE
  SUICIDAL
  HATE_SPEECH
  NSFW
  DOXXING
  MISINFORMATION
  OTHER
}

model User {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  ipHash    String?
  ipRaw     String?

  comments   Comment[]
  submissions Submission[]
  series     Series[]
  reactions  Reaction[]
  reports    Report[]
  bookmarks  Bookmark[]
}

model Series {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  title      String

  submissions Submission[]

  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

model Submission {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  submissionType SubmissionType
  title      String
  content    String
  tags       Tag[]
  language   String?

  isPublished Boolean    @default(true)
  isFlagged   Boolean    @default(false)
  isOffensive Boolean    @default(false)
  isSuicidal  Boolean    @default(false)
  isPinned    Boolean    @default(false)
  isDraft     Boolean    @default(false)

  partNumber Int?
  seriesId  String?
  series    Series?    @relation(fields: [seriesId], references: [id])

  comments  Comment[]
  reactions Reaction[]
  reports   Report[]
  bookmarks Bookmark[]
  translations Translation[]

  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

model Reaction {
  id        String       @id @default(uuid())
  createdAt  DateTime    @default(now())

  type      ReactionType

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  commentId String?
  comment   Comment?   @relation(fields: [commentId], references: [id])

  userId    String
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, submissionId])
  @@unique([userId, commentId])
}

model Report {
  id        String       @id @default(uuid())
  createdAt  DateTime    @default(now())

  reason    ReportReason
  details   String?

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  commentId String?
  comment   Comment?   @relation(fields: [commentId], references: [id])

  userId    String
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, submissionId])
  @@unique([userId, commentId])
}

model Tag {
  id        String      @id @default(uuid())
  name      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  submissions Submission[]
}

model Bookmark {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])

  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

model Comment {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  content    String
  language   String?

  isPublished  Boolean     @default(true)
  isFlagged  Boolean     @default(false)
  isOffensive  Boolean     @default(false)
  isPinned  Boolean     @default(false)

  submission   Submission  @relation(fields: [submissionId], references: [id])
  submissionId String

  parentId  String?
  parent    Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]   @relation("CommentReplies")

  user      User        @relation(fields: [userId], references: [id])
  userId    String

  reactions    Reaction[]
  reports      Report[]
  translations Translation[]
}

model Translation {
  id        String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  language  String
  content   String

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  commentId String?
  comment   Comment?   @relation(fields: [commentId], references: [id])

  @@unique([submissionId, language])
  @@unique([commentId, language])
}
